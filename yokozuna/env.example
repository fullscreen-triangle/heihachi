# Spotify OAuth (PKCE — no client secret needed)
# Get your Client ID from https://developer.spotify.com/dashboard
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# Redirect URIs to register in Spotify Dashboard:
#   Production:  https://your-vercel-domain.vercel.app/api/spotify/callback
#   Local dev:   http://localhost:3000/api/spotify/callback

# Python acoustic worker (whole-item / DJ-set resolution).
# Base URL of the Heihachi Flask service (api_server.py) that hosts
# /api/v1/resolve. Optional: if unset, /api/resolve degrades to a
# metadata-only signature (tracklist from the link's description) and shows
# residual gaps honestly. The worker itself needs yt-dlp, fpcalc (Chromaprint),
# and ACOUSTID_API_KEY set in ITS environment.
#   Local dev: http://localhost:5000
PYTHON_WORKER_URL=
